NODE_ENV=production
PORT=3001
# Supabase acessível a partir do container da API.
SUPABASE_URL=https://supabase.example.com
# Publishable/anon: usada para executar consultas sob o JWT do usuário e respeitar RLS.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_example
# Secret/service role: somente API; convites, auditoria e operações administrativas.
SUPABASE_SECRET_KEY=sb_secret_example
SUPABASE_JWT_SECRET=gere_o_valor_do_jwt_secret_do_supabase
# Compatibilidade temporária durante a rotação de nomes antigos.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional para migrations/diagnóstico direto. Nunca enviar ao web.
DATABASE_URL=postgresql://user:password@host:5432/postgres
# 32 bytes em base64 para AES-256-GCM. Ex.: openssl rand -base64 32
CERTIFICATE_ENCRYPTION_KEY=
# 1 = produção; 2 = homologação.
NFE_ENVIRONMENT=1
NFE_TIMEOUT_MS=30000
# Quantidade máxima de resumos conhecidos revisitada por sincronização.
NFE_RECONCILIATION_BATCH_SIZE=10
# Integração legada APFiscal (fallback).
APFISCAL_BASE_URL=https://api.example.com/apfiscal/rotas
APFISCAL_DEFAULT_API_KEY=
APFISCAL_CADASTRO_TOKEN=
APFISCAL_ENC_KEY=
# CORS é desnecessário no Dokploy (API interna), mas útil em desenvolvimento local.
WEB_ORIGIN=http://localhost:3000
# URL pública do web, usada nos e-mails do módulo de autenticação próprio do APFiscal.
PUBLIC_APP_URL=http://localhost:3000
# SMTP para cadastro, confirmação, convites e redefinição de senha.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario_smtp
SMTP_PASSWORD=senha_smtp
MAIL_FROM="APFiscal <no-reply@example.com>"
# Segredo próprio da sessão APFiscal (mínimo 32 caracteres aleatórios).
AUTH_SESSION_SECRET=gere_com_openssl_rand_hex_32

# Filas BullMQ. No Compose Dokploy use redis://apfiscal-redis:6379/0.
REDIS_URL=redis://localhost:6379/0

# TOTVS RM / SQL Server. Use um login SQL com permissão somente SELECT.
TOTVS_SQL_HOST=sqlserver.exemplo.local
TOTVS_SQL_PORT=1433
TOTVS_SQL_DATABASE=CORPORERM
TOTVS_SQL_USER=apfiscal_reader
TOTVS_SQL_PASSWORD=
TOTVS_SQL_ENCRYPT=true
TOTVS_SQL_TRUST_SERVER_CERTIFICATE=false
TOTVS_SQL_CONNECTION_TIMEOUT_MS=15000
TOTVS_SQL_REQUEST_TIMEOUT_MS=60000
TOTVS_SQL_POOL_MAX=5
TOTVS_COLIGADAS=1,2
TOTVS_CONNECTION_KEY=TOTVS_GRANJA
TOTVS_CONNECTION_DESCRIPTION=TOTVS_GRANJA
TOTVS_CONNECTION_KEYS=TOTVS_GRANJA
TOTVS_DEFAULT_CONNECTION_KEY=TOTVS_GRANJA
TOTVS_CONNECTION_TOTVS_GRANJA_DESCRIPTION=TOTVS_GRANJA
TOTVS_CONNECTION_TOTVS_GRANJA_HOST=sqlserver.exemplo.local
TOTVS_CONNECTION_TOTVS_GRANJA_PORT=1433
TOTVS_CONNECTION_TOTVS_GRANJA_DATABASE=CorporeRM
TOTVS_CONNECTION_TOTVS_GRANJA_USER=apfiscal_reader
TOTVS_CONNECTION_TOTVS_GRANJA_PASSWORD=
TOTVS_CONNECTION_TOTVS_GRANJA_COLIGADAS=1,2
TOTVS_CONNECTION_TOTVS_GRANJA_ENCRYPT=true
TOTVS_CONNECTION_TOTVS_GRANJA_TRUST_SERVER_CERTIFICATE=false
TOTVS_CONNECTION_TOTVS_GRANJA_WRITES_ENABLED=false
SUPERADMIN_EMAIL=superadmin@aptechinfo.com.br
SUPERADMIN_INITIAL_PASSWORD=
NFSE_ADN_BASE_URL=https://adn.nfse.gov.br/contribuintes
NFSE_ADN_TIMEOUT_MS=30000
NFSE_ADN_BATCH_SIZE=20
NFSE_ADN_MIN_INTERVAL_MINUTES=15
TOTVS_INITIAL_SYNC_DATE=2000-01-01T00:00:00.000Z
# Mantenha false até homologar e versionar o SQL de inclusão do movimento RM.
TOTVS_WRITES_ENABLED=false
