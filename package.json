{
  "name": "apfiscal",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @apfiscal/web --filter @apfiscal/api dev",
    "dev:web": "pnpm --filter @apfiscal/web dev",
    "dev:api": "pnpm --filter @apfiscal/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "3.7.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
