# URL pública da Data API do Supabase; o navegador acessa dados pelo proxy do backend.
NEXT_PUBLIC_SUPABASE_URL=https://supabase.example.com
# Chave publishable/anon. É pública por definição; nunca use a secret/service_role aqui.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example
# Em desenvolvimento local. O Compose do Dokploy substitui pelo hostname interno apfiscal-api.
INTERNAL_API_URL=http://localhost:3001
AUTH_SESSION_SECRET=use_o_mesmo_valor_configurado_na_api
# URL pública do web, usada em redirects de autenticação.
NEXT_PUBLIC_APP_URL=http://localhost:3000
